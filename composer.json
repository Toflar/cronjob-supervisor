{
    "name": "toflar/cronjob-supervisor",
    "description": "A simple supervisor for processes that can be triggered using a minutely cronjob",
    "type": "library",
    "require": {
        "php": "^8.1",
        "symfony/process": "^6.0 || ^7.0 || ^8.0",
        "symfony/lock": "^6.0 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2",
        "terminal42/code-quality-tools": "@dev"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Toflar\\CronjobSupervisor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toflar\\CronjobSupervisor\\Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Yanick Witschi",
            "email": "yanick.witschi@terminal42.ch"
        }
    ],
    "config": {
        "allow-plugins": {
            "terminal42/code-quality-tools": true
        }
    },
    "scripts": {
        "unix-tests": "@php vendor/bin/phpunit --testsuite=unix",
        "windows-tests": "@php vendor/bin/phpunit --testsuite=windows",
        "cs-fixer": "@php vendor/terminal42/code-quality-tools/tools/ecs/vendor/bin/ecs check src tests --config vendor/terminal42/code-quality-tools/tools/ecs/config.php --fix --ansi",
        "rector": "@php vendor/terminal42/code-quality-tools/tools/rector/vendor/bin/rector process src tests --config vendor/terminal42/code-quality-tools/tools/rector/config.php --ansi",
        "phpstan": "@php vendor/terminal42/code-quality-tools/tools/phpstan/vendor/bin/phpstan analyze src tests --configuration vendor/terminal42/code-quality-tools/tools/phpstan/config.php --ansi",
        "code-quality": [
            "@php vendor/terminal42/code-quality-tools/tools/ecs/vendor/bin/ecs check src tests --config vendor/terminal42/code-quality-tools/tools/ecs/config.php --no-progress-bar --no-interaction",
            "@php vendor/terminal42/code-quality-tools/tools/rector/vendor/bin/rector process src tests --config vendor/terminal42/code-quality-tools/tools/rector/config.php --dry-run --no-progress-bar",
            "@phpstan",
            "@php vendor/terminal42/code-quality-tools/tools/composer-dependency-analyser/vendor/bin/composer-dependency-analyser --config vendor/terminal42/code-quality-tools/tools/composer-dependency-analyser/config.php",
            "@php vendor/terminal42/code-quality-tools/tools/yamllint/vendor/bin/yaml-lint .github",
            "@composer validate --strict --no-check-publish"
        ]
    }
}
